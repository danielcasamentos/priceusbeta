{
  "name": "priceus-desktop",
  "private": true,
  "version": "2.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node server/whatsapp-gateway.js\"",
    "server": "node server/whatsapp-gateway.js",
    "build": "vite build",
    "electron:dev": "electron .",
    "dist:mac": "ELECTRON=true vite build && electron-packager . \"PriceUS_Desktop\" --platform=darwin --arch=arm64 --icon=public/Logo_price_Us_512x512.icns --out=dist-app --overwrite",
    "dist:win": "cross-env ELECTRON=true vite build && electron-builder --win nsis --config.extraMetadata.main=electron/main.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "graph": "npx graphify update"
  },
  "build": {
    "appId": "br.com.priceus.app",
    "productName": "PriceU$ Desktop",
    "directories": {
      "output": "public/downloads"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Instalar PriceU$ Desktop v${version}"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@stripe/stripe-js": "^8.8.0",
    "@supabase/supabase-js": "^2.57.4",
    "@types/jszip": "^3.4.0",
    "@whiskeysockets/baileys": "^6.17.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "graphifyy": "^0.10.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.344.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "quill": "^2.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-input-mask": "^2.0.4",
    "react-quill": "^2.0.0",
    "react-router-dom": "^7.9.5",
    "recharts": "^2.8.0",
    "tailwind-merge": "^3.3.1",
    "workbox-precaching": "^7.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.2.4",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^6.4.1",
    "vite-plugin-pwa": "^1.2.0"
  }
}
